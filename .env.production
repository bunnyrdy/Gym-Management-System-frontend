# Production build: `npm run build`.
#
# Relative, exactly like .env.demo and for the same reason. services/api.ts
# derives the upload origin by stripping "/api" off this value, so "/api"
# leaves the origin empty and every request — API calls and <img> sources
# alike — resolves against whatever host is serving the page.
#
# That is what keeps the domain out of the bundle: Caddy serves these static
# files and reverse-proxies /api and /uploads to the API container, so the
# browser only ever talks to one origin. Moving the gym to a new hostname is
# then a DNS change and a Caddyfile line, not a rebuild.
VITE_API_BASE_URL=/api
