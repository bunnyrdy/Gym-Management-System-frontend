# Demo mode: `npm run demo:build` / `npm run demo:preview`.
#
# Relative, not absolute. `services/api.ts` derives the upload origin by
# stripping "/api" off this value, so "/api" leaves the origin empty and every
# request — API calls and <img> sources alike — resolves against whatever host
# is serving the page. That is what lets one build run on localhost, on a LAN
# address, or behind a Cloudflare tunnel hostname that changes every run.
#
# Vite forwards /api and /uploads to http://localhost:5023 (see vite.config.ts),
# so the backend never has to be exposed.
VITE_API_BASE_URL=/api
